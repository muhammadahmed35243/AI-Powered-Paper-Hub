# Copy this file to ".env" in the same folder (repository root) and fill in your values.
# .env is gitignored — never commit real keys.

# --- Database ---
ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=ResearchHubDb;Trusted_Connection=True;MultipleActiveResultSets=true

# --- JWT (API) ---
Jwt__Key=CHANGE_ME_at_least_32_characters_long
Jwt__Issuer=ResearchHubAPI
Jwt__Audience=ResearchHubUsers
Jwt__ExpireDays=7

# --- Google OAuth (one ID for API token validation + Blazor sign-in button) ---
Google__ClientId=your-client-id.apps.googleusercontent.com

# --- External APIs ---
SerpApi__ApiKey=
SerpApi__MaxResults=10
OpenAI__ApiKey=
OpenAI__Model=gpt-4o-mini

# --- Admin users (promoted to IsAdmin on login) ---
Admin__Emails__0=you@example.com

# --- Blazor Web ---
ApiBaseUrl=http://localhost:5291

# --- WinForms Admin ---
ResearchHub__ApiBaseUrl=http://localhost:5291
